# ============================================================
# Agent Inbox — example environment file
# Copy this file to ".env" and fill in your values:
#     cp .env.example .env
# Never commit .env (it's already in .gitignore).
# ============================================================

# ---- Required -------------------------------------------------

# The Gmail address the agent checks. This can be a brand-new account
# created just for the agent (recommended: the agent owns its own inbox).
GMAIL_EMAIL=agent-name@gmail.com

# A Gmail App Password (NOT the account's normal password).
# Requires: 2-Step Verification ON, then Google Account → Security →
# "App passwords" → generate a 16-character password for "Mail".
# Also enable IMAP: Gmail → Settings → See all settings →
# Forwarding and POP/IMAP → Enable IMAP.
GMAIL_APP_PASSWORD=your-16-character-app-password

# Where the email archive lives on disk. The library creates
# record/emails/ (inbox/, sent/, drafts/, outbox/, failed/, index.json)
# inside this path. Point it at:
#   - a dedicated private repo you cloned locally (RECOMMENDED), or
#   - a folder inside your existing private repo, or
#   - a folder inside a public repo (NOT recommended — emails are private).
EMAIL_ARCHIVE_REPO_PATH=/absolute/path/to/your/archive

# ---- Optional -------------------------------------------------

# Operator/admin address that receives the optional session-digest email.
# Leave blank to disable digests.
OPERATOR_EMAIL=

# Display name used in digests and log lines.
AGENT_NAME=My Agent

# IANA timezone used for archive timestamps.
TIMEZONE=America/Los_Angeles

# ---- About GitHub secrets -------------------------------------
# This LIBRARY needs no GitHub secrets: it reads the values above and writes
# plain files to EMAIL_ARCHIVE_REPO_PATH. Git commit/push is YOUR job (or your
# scheduler's). If you deploy this inside GitHub Actions to run on a schedule
# and commit the archive, set the following in the ARCHIVE repo's Settings →
# Secrets and variables → Actions:
#   GMAIL_EMAIL, GMAIL_APP_PASSWORD, OPERATOR_EMAIL (optional),
#   and a token with write access to the archive repo (or the built-in
#   GITHUB_TOKEN) for the commit step.
